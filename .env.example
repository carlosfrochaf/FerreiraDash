# --- Banco (PostgreSQL) ---
# Local com Docker: `docker compose up -d` usa as variáveis DB_* abaixo.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ferreira_rocha?schema=public"
# Conexão direta (sem pooler), usada pelas migrations. Localmente pode ser igual à DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ferreira_rocha?schema=public"

DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ferreira_rocha

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Senha de acesso ao sistema (obrigatória em produção; sem ela o site fica bloqueado).
# Use uma senha longa. Trocar a senha desloga todos os aparelhos.
APP_PASSWORD=""

# --- Notificações push ---
# Gere as chaves com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Segredo que o cron envia em "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=""

# --- Datajud (busca de processos) ---
# Chave pública atual: https://datajud-wiki.cnj.jus.br/api-publica/acesso
DATAJUD_API_KEY=""
