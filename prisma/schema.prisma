// Ferreira & Rocha — Controle Financeiro Jurídico
// Banco: PostgreSQL (dev e produção). Alterações via `prisma migrate`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TipoTransacao {
  ENTRADA
  SAIDA
}

enum StatusTransacao {
  PAGO
  PENDENTE
  NAO_PAGO
}

model Categoria {
  id        String        @id @default(cuid())
  nome      String
  slug      String?       @unique // Slugs do sistema (ex: "AUDIENCIA", "REPASSE_CLIENTE")
  tipo      TipoTransacao
  ativo     Boolean       @default(true)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  transacoes Transacao[]

  @@map("categorias")
}

enum TipoContato {
  CLIENTE
  ADVOGADO_PARCEIRO
  FORNECEDOR
  COLABORADOR
}

model Contato {
  id        String   @id @default(cuid())
  nome      String
  tipo      TipoContato
  email     String?
  telefone  String?
  cpfCnpj   String?  @map("cpf_cnpj")
  pixChave  String?  @map("pix_chave")
  banco     String?
  agencia   String?
  conta     String?
  observacoes String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  processos    Processo[]
  transacoes   Transacao[]

  @@map("contatos")
}

model Processo {
  id            String   @id @default(cuid())
  numeroPje     String   @unique @map("numero_pje")
  nomeAcao      String   @map("nome_acao")
  clienteId     String   @map("cliente_id")
  cliente       Contato  @relation(fields: [clienteId], references: [id])
  observacoes   String?
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  transacoes    Transacao[]
  repasses      Repasse[]
  recebimentos  Recebimento[]

  @@index([clienteId])
  @@map("processos")
}

model Transacao {
  id                String             @id @default(cuid())
  tipo              TipoTransacao
  valor             Decimal
  dataCompetencia   DateTime           @map("data_competencia")
  dataPagamento     DateTime?          @map("data_pagamento")
  status            StatusTransacao    @default(PENDENTE)
  descricao         String?
  anexoUrl          String?            @map("anexo_url")
  anexoNome         String?            @map("anexo_nome")

  // Novos campos opcionais da Causa Jurídica
  processoNumero    String?            @map("processo_numero")
  clienteNome       String?            @map("cliente_nome")
  reclamada         String?

  categoriaId       String             @map("categoria_id")
  categoria         Categoria          @relation(fields: [categoriaId], references: [id])

  processoId        String?            @map("processo_id")
  processo          Processo?          @relation(fields: [processoId], references: [id])
  contatoId         String?            @map("contato_id")
  contato           Contato?           @relation(fields: [contatoId], references: [id])

  repasseId         String?            @map("repasse_id")
  repasse           Repasse?           @relation(fields: [repasseId], references: [id])

  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@index([tipo, status])
  @@index([categoriaId])
  @@index([dataCompetencia])
  @@index([processoId])
  @@index([contatoId])
  @@map("transacoes")
}

/// Registro do fluxo de repasse jurídico (alvará → honorários escritório + repasse cliente)
model Repasse {
  id                    String    @id @default(cuid())
  processoId            String    @map("processo_id")
  processo              Processo  @relation(fields: [processoId], references: [id])
  valorTotalRecebido    Decimal   @map("valor_total_recebido")
  percentualEscritorio  Decimal   @map("percentual_escritorio")
  valorEscritorio       Decimal   @map("valor_escritorio")
  valorCliente          Decimal   @map("valor_cliente")
  dataRecebimento       DateTime  @map("data_recebimento")
  observacoes           String?
  createdAt             DateTime  @default(now()) @map("created_at")

  transacoes            Transacao[]

  @@index([processoId])
  @@map("repasses")
}

enum StatusRecebimento {
  PENDENTE
  RECEBIDO
}

enum StatusRepasse {
  PENDENTE
  REPASSADO
}

/// Causa/acordo: valor total dividido em parcelas, com a parte do escritório e a do cliente.
model Recebimento {
  id                     String    @id @default(cuid())
  processoId             String?   @map("processo_id")
  processo               Processo? @relation(fields: [processoId], references: [id])
  processoNumero         String?   @map("processo_numero")
  clienteNome            String    @map("cliente_nome")
  reclamada              String?
  valorTotal             Decimal   @map("valor_total") @db.Decimal(14, 2)
  percentualEscritorio   Decimal   @map("percentual_escritorio") @db.Decimal(5, 2)
  numeroParcelas         Int       @map("numero_parcelas")
  dataPrimeiroVencimento DateTime  @map("data_primeiro_vencimento") @db.Date
  diaVencimento          Int       @map("dia_vencimento")
  observacoes            String?
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  parcelas               Parcela[]

  @@index([processoId])
  @@map("recebimentos")
}

/// Uma linha por parcela (à vista = 1 parcela). Valores calculados e gravados na criação.
model Parcela {
  id                     String            @id @default(cuid())
  recebimentoId          String            @map("recebimento_id")
  recebimento            Recebimento       @relation(fields: [recebimentoId], references: [id], onDelete: Cascade)
  numero                 Int
  vencimento             DateTime          @db.Date
  valorParcela           Decimal           @map("valor_parcela") @db.Decimal(14, 2)
  valorEscritorio        Decimal           @map("valor_escritorio") @db.Decimal(14, 2)
  valorCliente           Decimal           @map("valor_cliente") @db.Decimal(14, 2)
  statusRecebimento      StatusRecebimento @default(PENDENTE) @map("status_recebimento")
  dataRecebimento        DateTime?         @map("data_recebimento") @db.Date
  statusRepasse          StatusRepasse     @default(PENDENTE) @map("status_repasse")
  dataRepasse            DateTime?         @map("data_repasse") @db.Date
  comprovanteRepasseUrl  String?           @map("comprovante_repasse_url")
  comprovanteRepasseNome String?           @map("comprovante_repasse_nome")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")

  @@unique([recebimentoId, numero])
  @@index([vencimento])
  @@index([statusRecebimento, vencimento])
  @@index([statusRepasse, statusRecebimento])
  @@map("parcelas")
}

enum StatusPagamento {
  PENDENTE
  PAGO
}

/// Audiência feita por um advogado (geralmente parceiro), que o escritório paga depois.
model Audiencia {
  id              String          @id @default(cuid())
  data            DateTime        @db.Date
  hora            String?         // "14:30"
  advogadoNome    String          @map("advogado_nome")
  clienteNome     String          @map("cliente_nome")
  reclamada       String?
  processoNumero  String?         @map("processo_numero")
  /// Quanto o escritório paga ao advogado. Pode ser definido depois.
  valor           Decimal?        @db.Decimal(14, 2)
  statusPagamento StatusPagamento @default(PENDENTE) @map("status_pagamento")
  dataPagamento   DateTime?       @map("data_pagamento") @db.Date
  observacoes     String?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@index([data])
  @@index([statusPagamento, data])
  @@map("audiencias")
}

enum StatusPeticao {
  A_VALIDAR
  A_PAGAR
  PAGA
}

/// Petição feita por um advogado (geralmente parceiro): entregue → validada → paga.
model Peticao {
  id             String        @id @default(cuid())
  advogadoNome   String        @map("advogado_nome")
  clienteNome    String        @map("cliente_nome")
  reclamada      String?
  processoNumero String?       @map("processo_numero")
  /// Qual petição foi feita (ex.: "Contestação", "Recurso ordinário").
  descricao      String
  dataEntrega    DateTime      @map("data_entrega") @db.Date
  /// Quanto o escritório paga ao advogado. Obrigatório para marcar como paga.
  valor          Decimal?      @db.Decimal(14, 2)
  status         StatusPeticao @default(A_VALIDAR)
  dataValidacao  DateTime?     @map("data_validacao") @db.Date
  dataPagamento  DateTime?     @map("data_pagamento") @db.Date
  observacoes    String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([status, dataEntrega])
  @@index([dataPagamento])
  @@map("peticoes")
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("push_subscriptions")
}
